# Copy this file to .env and fill in real values. Never commit .env.
#
# Required vars (src/config.ts throws at boot listing anything missing):
# DATABASE_URL, SHOPIFY_STORE_DOMAIN, SHOPIFY_API_KEY, SHOPIFY_API_SECRET_KEY,
# HUBSPOT_CLIENT_ID, HUBSPOT_CLIENT_SECRET, OAUTH_STATE_SECRET, ADMIN_API_KEY,
# ENCRYPTION_KEY. Everything else below is optional with a sensible default.

# --- Server ---
PORT=3000
# Public base URL this instance is reachable at. Leave blank locally
# (falls back to http://localhost:PORT); set to the deployed HTTPS URL in
# production — only matters for re-running an OAuth handshake or
# registering webhooks, since tokens themselves live in the database.
APP_URL=
# Gates GET /sync-status and the /merchants/:shop/* dashboard endpoints for
# the operator (global, cross-merchant). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
# How long sync_log rows (customer emails, order numbers) are kept before an
# automatic daily cleanup deletes them (src/db/syncLog.ts's deleteOldSyncLog,
# scheduled from server.ts). Defaults to 90 days if unset.
SYNC_LOG_RETENTION_DAYS=90

# --- Persistence: Supabase or Neon free-tier Postgres connection string.
# Stores everything per-merchant (Shopify/HubSpot tokens, deal rules, sync
# log) in the `merchants`/`sync_log` tables, auto-created on first query.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Shopify app (Partner Dashboard -> your app -> Configuration). Needs
# "Embed app in Shopify admin" unchecked (this is a headless service) and
# "Use legacy install flow" checked. Required scopes:
# read_orders,read_customers,read_products. Redirect URL to register:
# <APP_URL>/auth/shopify/callback (plus http://localhost:3000/auth/shopify/callback
# for local dev).
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET_KEY=
SHOPIFY_API_VERSION=2026-07
# Legacy: only needed to seed a single-store local dev database on first
# run before any merchant has actually completed the OAuth handshake
# (src/shopify/token.ts). Safe to leave blank once that's happened once —
# the database becomes the real source of truth from then on.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- HubSpot OAuth app (each merchant connects their own portal — this is
# not a static Private App token). HubSpot CLI project (`hs project create`,
# Distribution: marketplace, Authentication: oauth) -> app-hsmeta.json for
# client ID/secret and required scopes
# (crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.objects.line_items.read/write), redirect URL
# <APP_URL>/auth/hubspot/callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Signs the stateless `state` param for both the Shopify and HubSpot OAuth
# handshakes — deliberately its own secret, not shared with
# SHOPIFY_API_SECRET_KEY, since these are two independent trust boundaries.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# AES-256-GCM key encrypting merchants.shopify_access_token/
# hubspot_access_token/hubspot_refresh_token at rest (src/crypto.ts). Base64,
# must decode to exactly 32 bytes. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every already-encrypted row undecryptable — treat it
# like a database password, not a config value to casually regenerate.
# If you have more than one environment sharing the same database (e.g.
# local dev pointed at a shared staging DB), this MUST be the identical
# value on every side that reads/writes merchant rows.
ENCRYPTION_KEY=
