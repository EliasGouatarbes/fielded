{
  "name": "hubspot-shopify-sync",
  "version": "0.1.0",
  "description": "Reliable Shopify -> HubSpot sync for small merchants (Customers to Contacts, Orders to Deals, line items, historical backfill)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/supabase-ca.crt', 'dist/db/supabase-ca.crt')\"",
    "start": "node dist/server.js",
    "backfill": "ts-node --transpile-only src/scripts/backfill.ts",
    "register-webhooks": "ts-node --transpile-only src/scripts/register-webhooks.ts",
    "migrate-merchants": "ts-node --transpile-only src/scripts/migrate-merchants.ts",
    "encrypt-existing-tokens": "ts-node --transpile-only src/scripts/encrypt-existing-tokens.ts",
    "test": "node --require ts-node/register/transpile-only --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hubspot/api-client": "^14.0.1",
    "@shopify/admin-api-client": "^1.1.2",
    "@shopify/shopify-api": "^13.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "license": "UNLICENSED",
  "private": true
}
